{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allagma.org/contracts/0.2/AnalysisRecord",
  "title": "AnalysisRecord",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "record_type": {
      "const": "AnalysisRecord"
    },
    "analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "raw_manifest": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "retention"
      ],
      "additionalProperties": false
    },
    "analysis_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "retention"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "retention"
        ],
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "retention"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "analysis_id",
    "raw_manifest",
    "analysis_revision",
    "code",
    "configuration",
    "outputs",
    "exclusions",
    "uncertainty",
    "dependencies"
  ],
  "additionalProperties": false
}
