{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allagma.org/contracts/0.2/ReviewRecord",
  "title": "ReviewRecord",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "record_type": {
      "const": "ReviewRecord"
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "backend": {
      "type": "string",
      "minLength": 1
    },
    "backend_version": {
      "type": "string",
      "minLength": 1
    },
    "material": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "retention": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "retention"
      ],
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "revise",
        "blocked"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "retention"
        ],
        "additionalProperties": false
      }
    },
    "assurance": {
      "enum": [
        "deterministic",
        "provisional",
        "independent"
      ]
    },
    "coverage": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "review_id",
    "reviewer",
    "backend",
    "backend_version",
    "material",
    "criteria",
    "verdict",
    "findings",
    "trace",
    "assurance",
    "coverage"
  ],
  "additionalProperties": false
}
