{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allagma.org/contracts/0.2/RunRecord",
  "title": "RunRecord",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "record_type": {
      "const": "RunRecord"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "retention"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "retention": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "media_type",
          "retention"
        ],
        "additionalProperties": false
      }
    },
    "environment": {
      "type": "object"
    },
    "model_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "money_usd": {
          "type": "number",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "wall_seconds",
        "money_usd",
        "tokens"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "interrupted"
      ]
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "protocol_revision": {
      "type": "string",
      "minLength": 1
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "pilot",
        "confirmation",
        "discovery"
      ]
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "attempt_id",
    "attempt_number",
    "campaign_id",
    "experiment_id",
    "started_at",
    "ended_at",
    "inputs",
    "outputs",
    "environment",
    "model_revision",
    "data_revision",
    "usage",
    "status",
    "error",
    "protocol_revision",
    "bundle_id",
    "split",
    "command",
    "exit_code"
  ],
  "additionalProperties": false
}
