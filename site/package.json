{
  "name": "allagma-docs",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "npm run sync && astro dev --host 127.0.0.1",
    "build": "npm run sync && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.3.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.11.1"
  },
  "overrides": {
    "postcss-nested": { "postcss-selector-parser": "7.1.6" }
  }
}
