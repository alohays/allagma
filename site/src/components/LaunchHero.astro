---
import WorkflowVideo from './WorkflowVideo.astro';
const base = '/allagma/';
---
<section class="launch-hero" aria-labelledby="_top">
  <div class="hero-copy">
    <p class="eyebrow">Allagma / for researchers using coding agents</p>
    <h1 id="_top" data-page-title>Have your coding agent <em>carry out a study.</em></h1>
    <p class="hero-description">Supply a question, source materials and resource limits. Your agent plans the study, writes and runs the code, analyzes the results, and drafts a report.</p>
    <p class="hero-delivery">Receive the figures and report with the code, data and attempt history needed to check them.</p>
    <div class="hero-actions">
      <a class="primary-action" href={base+'studies/ema-schedule/'}>Read a completed study <span aria-hidden="true">→</span></a>
      <a class="text-action" href={base+'guides/first-study/'}>Try the offline example <span aria-hidden="true">→</span></a>
    </div>
    <p class="hero-footnote">Offline example: Python 3.11+, Git, no model account.</p>
  </div>
  <div class="hero-demo">
    <WorkflowVideo compact />
    <a class="text-action demo-detail-link" href={base+'demo/'}>Chapters, transcript and downloads <span aria-hidden="true">→</span></a>
  </div>
</section>
