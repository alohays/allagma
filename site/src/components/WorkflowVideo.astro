---
const base = '/allagma/generated/media/demo/';
---
<figure class="workflow-video">
  <video controls playsinline preload="none" poster={`${base}poster.png`} aria-label="Allagma workflow demonstration, with English captions" width="1600" height="900">
    <source src={`${base}allagma-workflow.mp4`} type="video/mp4" />
    <track kind="captions" src={`${base}allagma-workflow.en.vtt`} srclang="en" label="English" default />
    <p><a href={`${base}allagma-workflow.mp4`}>Download the video</a> or <a href="/allagma/demo/transcript/">read its transcript</a>.</p>
  </video>
  <figcaption>Actual local execution · about 100 seconds · 2.9 MB · English captions and transcript</figcaption>
</figure>
<style>
  .workflow-video { margin: 1.5rem 0; }
  video { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 7px; background: #102c24; }
  video::cue { font-family: system-ui,sans-serif; }
  figcaption { font-size: .75rem; color: var(--muted); margin-top: .7rem; }
</style>
